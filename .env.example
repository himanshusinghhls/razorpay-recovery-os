# ============================================================
# APPLICATION
# ============================================================

APP_ENV=development
APP_NAME=recovery-os
APP_PORT=8000

# ============================================================
# RAZORPAY
# ============================================================

RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME

# Without this the webhook endpoint refuses every event rather than
# accepting unverifiable ones.
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME

# ============================================================
# AUTH
# ============================================================

# Signs access and refresh tokens. Minimum 32 characters; the app refuses to
# start on a placeholder. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_ME_WITH_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Server-to-server key for machine clients. This is NOT used by the browser —
# dashboard users authenticate with their own credentials at /login.
API_KEY=REPLACE_ME

# ============================================================
# DATABASE
# ============================================================

DATABASE_URL=postgresql://recovery:recovery_password@localhost:5432/recovery_os

# Per-process pool. Total connections = these x uvicorn worker count, which
# must stay below the server's max_connections.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ============================================================
# REDIS  (job queue, rate limits, idempotency keys)
# ============================================================

REDIS_URL=redis://localhost:6379/0

# ============================================================
# RATE LIMITING
# ============================================================

RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_WRITE_PER_MINUTE=30

# Number of reverse proxies in front of this service. Leave at 0 unless you
# actually run behind one: any value above 0 makes the app trust
# X-Forwarded-For, which a direct caller can forge to evade rate limits.
TRUSTED_PROXY_HOPS=0

# ============================================================
# CORS
# ============================================================

CORS_ORIGINS=["http://localhost:3000"]

# ============================================================
# AI (Google Gemini)
# ============================================================

# Optional. Without it the analyst agent falls back to the deterministic
# YAML taxonomy and the pipeline keeps working.
GEMINI_API_KEY=REPLACE_ME
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2

# ============================================================
# FRONTEND
# ============================================================
#
# NOTE: Next.js only inlines NEXT_PUBLIC_* variables from apps/web/.env.local,
# never from this file. See apps/web/.env.example.

NEXT_PUBLIC_API_URL=http://localhost:8000
