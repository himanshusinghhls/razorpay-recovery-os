# Next.js inlines NEXT_PUBLIC_* variables at build time from THIS directory.
# The repo-root .env is not read by the frontend — a variable referenced in
# client code but defined only there resolves to undefined at runtime.
#
# Copy to .env.local to use.

NEXT_PUBLIC_API_URL=http://localhost:8000

# There is deliberately no API key here. Anything prefixed NEXT_PUBLIC_ is
# embedded in the JavaScript bundle and readable by every visitor, so it can
# never hold a secret. Users authenticate with their own credentials.
